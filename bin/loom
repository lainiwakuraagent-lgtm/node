#!/usr/bin/env bash
# loom — per-agent Loom CLI wrapper.
# Reads LOOM_SRC and LOOM_DB from state/agent_config.env if available,
# so every node instance uses its own database without manual editing.
_PROJECT_DIR="${PROJECT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
_AGENT_CFG="${_PROJECT_DIR}/state/agent_config.env"

LOOM_DIR=""
LOOM_DB=""
if [ -f "$_AGENT_CFG" ]; then
  _val=$(grep "^LOOM_SRC=" "$_AGENT_CFG" 2>/dev/null | cut -d= -f2-)
  [ -n "$_val" ] && LOOM_DIR="$_val"
  _val=$(grep "^LOOM_DB=" "$_AGENT_CFG" 2>/dev/null | cut -d= -f2-)
  [ -n "$_val" ] && LOOM_DB="$_val"
fi

LOOM_DIR="${LOOM_DIR:-${_PROJECT_DIR}/loom}"
LOOM_DB="${LOOM_DB:-${HOME}/.local/share/loom/loom.db}"

_loom_cli() {
  env PYTHONPATH="${LOOM_DIR}" "${LOOM_DIR}/.venv/bin/python" -m loom.cli --db "${LOOM_DB}" "$@"
}
case "${1:-}" in
  ls)   shift; _loom_cli task list --status "${1:-scheduled}" ;;
  show) _loom_cli task show "$2" ;;
  done) _loom_cli task edit --status done "$2" ;;
  fail) _loom_cli task edit --status failed "$2" ;;
  add)  shift; _loom_cli task add --name "${1:?name required}" --status scheduled "${@:2}" ;;
  next) _loom_cli queue ;;
  *)    _loom_cli "$@" ;;
esac
