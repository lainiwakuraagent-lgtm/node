# agent_config.env — Parameterize this node instance
#
# Copy this file to state/agent_config.env and fill in your values.
# wake.sh sources this file at startup if it exists.
#
# Usage:
#   cp state/agent_config.env.example state/agent_config.env
#   nano state/agent_config.env

# ── Identity ──────────────────────────────────────────────────────────────────

# AGENT_NAME: short handle for this agent (used in logs, persona, state files)
AGENT_NAME=myagent

# OWNER_NAME: short name for the person this agent reports to
# Used in relationship profile path: memory/work/musubi_data/users/$AGENT_NAME/$OWNER_NAME.md
OWNER_NAME=myowner

# ── Repository ────────────────────────────────────────────────────────────────

# AGENT_REPO: GitHub repo where THIS node's code lives (for self-update hook)
# Format: org/repo  (no https:// prefix)
AGENT_REPO=myorg/myagent-node

# ── CI/CD template sync ───────────────────────────────────────────────────────

# CI_CD_ENABLED: set to "true" to enable automatic template sync from blank_node
# on each wake. Default: false (opt-in, not opt-out).
# @Lain is hardcoded to false per Andrii's explicit decision (2026-08-04).
# CI_CD_ENABLED=false

# BLANK_NODE_DIR: absolute path to the local blank_node clone this agent syncs from.
# Required when CI_CD_ENABLED=true. Must be a git repo with origin/main accessible.
# For same-machine agents (e.g. fokacco-hp): /home/andrii/lain/blank_node
# For remote/container agents: set BLANK_NODE_REPO and let node_sync.sh clone on first run.
# BLANK_NODE_DIR=/home/OWNER/lain/blank_node

# BLANK_NODE_REPO: upstream repo URL used to bootstrap BLANK_NODE_DIR if it doesn't exist.
# Optional. When set and BLANK_NODE_DIR has no .git, node_sync.sh does a shallow clone here
# before running the normal sync. Leave unset if BLANK_NODE_DIR is a pre-existing local clone.
# Public repos need no credentials. For private repos, configure git credential helper first.
# BLANK_NODE_REPO=https://github.com/lainiwakuraagent-lgtm/node.git

# ── Model ─────────────────────────────────────────────────────────────────────

# NODE_VERSION: Claude model ID to use for sessions
# Options: claude-sonnet-4-6 | claude-haiku-4-5-20251001 | claude-opus-4-6
# If state/session_model.txt exists, that takes precedence at runtime.
NODE_VERSION=claude-sonnet-4-6

# ── Default goal ──────────────────────────────────────────────────────────────

# DEFAULT_GOAL_ID: Loom goal id invoked only when nothing else is eligible —
# no scheduled/in_progress goal, no scheduled/in_progress project, no ready
# task. Unstructured: never evaluated, planned, or audited like a normal
# goal — it's a standing purpose-holder the agent free-forms within
# (replaces the old default_goal.txt file). Must already exist as a real
# goal in this node's Loom DB; leave unset to fall back to plain philosophy
# with no goal framing.
#
# install.sh sets this automatically: if the Loom DB is empty at install
# time, it creates a standing "Onboarding" goal (investigate purpose from
# peer/orchestrator assignment, then owner direction, then genuine inquiry
# — see the goal's own description) and points this at it, so a fresh
# agent is never left with an empty Loom. Re-running install.sh preserves
# whatever value is already set here rather than re-deriving it. Only
# change this by hand once a real purpose-goal replaces onboarding.
# DEFAULT_GOAL_ID=1

# ── Execution session cap ─────────────────────────────────────────────────────

# EXECUTION_TASK_CAP: maximum number of Loom tasks the resolver exposes to a
# single execution session. Sessions stop and write task_cap_reached once this
# many tasks are completed, regardless of queue depth.
# Default: 2. Set to 1 for maximum cost predictability (one task per session).
EXECUTION_TASK_CAP=2

# ── Loom Database ─────────────────────────────────────────────────────────────

# LOOM_DB: absolute path to THIS node's Loom task database.
# Each agent MUST have its own database (one per agent, per Andrii's T400 decision).
# Convention: ~/.local/share/loom/${AGENT_NAME}.db
# provision_agent.sh sets this automatically during provisioning.
LOOM_DB=/home/OWNER/.local/share/loom/AGENT_NAME.db

# ── Honcho memory client (optional) ──────────────────────────────────────────

# HONCHO_URL: base URL of the Honcho server this agent should connect to.
# Leave unset (or blank) to disable Honcho — every function no-ops silently.
# Example: http://<TARGET_HOST>:8100
# HONCHO_URL=

# HONCHO_WORKSPACE: workspace ID within Honcho for this agent cluster.
# Convention: use a short slug matching the agent group (e.g. my-agent-workspace).
# HONCHO_WORKSPACE=

# HONCHO_AUTH_TOKEN: Bearer token, if AUTH_USE_AUTH is enabled on the Honcho server.
# Leave unset if the server runs in auth-disabled mode (most self-hosted setups).
# HONCHO_AUTH_TOKEN=

# ── Process control backend (T464) ───────────────────────────────────────────

# PROCESS_BACKEND: selects how tools/executional/procctl.sh manages services.
# Auto-detected at runtime (systemd if "systemctl --user" responds, else supervisord).
# Set explicitly to override: "systemd" on bare Linux, "supervisord" in Docker.
# Under supervisord, tools/executional/scheduler_loop.py (a supervisord program,
# see scripts/docker/supervisord.conf) replaces the systemd night-agent timer and
# emergency_mode.sh's timer -- both read this same file's PROCESS_BACKEND.
# PROCESS_BACKEND=systemd
