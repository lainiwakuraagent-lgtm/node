%% Component: pre-session gate tools — checks run by wake.sh before launching Claude.
%% These are read-only checks; none modify state. All are non-fatal (fail-open).
flowchart TD
    WS[wake.sh\nlauncher]

    subgraph Gates["Gate checks (pre-launch)"]
        CS[check_session.sh\nunified: --usage (Gate 0, reads Claude\nAPI usage, aborts if limit exceeded)\n--time (window awareness)\n--context (context window estimate,\nused mid-session too)]
    end

    subgraph Inbox["Inbox processing (session start)"]
        IB[inbox.py\nstartup: reads pending.json, creates\nLoom tasks from task_request entries\nread: inspect + prune entries\nappend: write new entry — used by conv layer]
    end

    WS -->|Gate 0| CS
    WS -->|session start| IB
